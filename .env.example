# Biblionx server and deployment settings. Copy to .env (never commit it).
# All values are optional; defaults are shown in comments.

# Bind address and port (default 127.0.0.1:8000; Docker image uses 0.0.0.0)
BIBLIONX_HOST=
BIBLIONX_PORT=

# Folder with sign PNGs. Images are NOT in the git repo (extraction artifacts).
# Default: <repo root>/extracted_images. Missing files fall back to text cards.
BIBLIONX_IMAGES_DIR=

# Per-client requests per minute for translate and words (default 120, 0 = off)
BIBLIONX_RATE_PER_MIN=

# Set to 1 only behind a trusted reverse proxy (client IP from X-Forwarded-For)
BIBLIONX_TRUST_PROXY=

# CORS: unset = same-origin only. Comma-separated origins, or * for any.
BIBLIONX_CORS_ORIGIN=

# 1/0 to enable/disable GET /api/v1/metrics (default: on for localhost only)
BIBLIONX_METRICS=

# Docker Compose only (deploy/docker-compose.yml)
BIBLIONX_DOMAIN=
BIBLIONX_IMAGES_HOST_DIR=

# Optional AI fallback for out-of-vocabulary words. OFF by default.
# Copy to .env (never commit it) and export the variables in your shell.
# Keys are read ONLY from environment variables.

# Provider: anthropic | openai | ollama (leave empty to disable)
BIBLIONX_LLM_PROVIDER=

# Optional model override (defaults: claude-haiku-4-5 / gpt-4o-mini / llama3.2)
BIBLIONX_LLM_MODEL=

# Max model calls per process. 0 or empty = unlimited (default, so a demo can
# translate broadly). Cached answers never count.
BIBLIONX_LLM_MAX_CALLS=

# Cost guard: max uncached model calls per minute, process-wide (sliding
# window). 0 or empty = off (default).
# RECOMMENDED for a public demo: BIBLIONX_LLM_RATE_PER_MIN=30, plus a monthly
# spend limit set in the provider console. Claude Haiku 4.5 costs about
# $0.0003 per uncached lookup (~250 input / 8 output tokens at $1/$5 per MTok).
BIBLIONX_LLM_RATE_PER_MIN=

# Anthropic
ANTHROPIC_API_KEY=

# OpenAI or any OpenAI-compatible server
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Ollama (default http://127.0.0.1:11434)
OLLAMA_URL=
